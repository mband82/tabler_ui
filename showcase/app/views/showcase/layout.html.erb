<% columns = [
  { label: "Name", value: ->(row) { row[:name] } },
  { label: "Role", value: ->(row) { row[:role] } },
  { label: "Status", class: "text-end",
    value: ->(row) { tabler_ui.status(text: row[:status], color: row[:status] == "Active" ? "success" : "secondary", dot: true) } }
] %>
<% rows = [
  { name: "Ada Lovelace", role: "Engineer", status: "Active" },
  { name: "Grace Hopper", role: "Admiral", status: "Active" },
  { name: "Alan Turing", role: "Researcher", status: "Away" }
] %>
<%= render layout: "showcase/example", locals: { title: "table - striped, hover, row_html:", code: snippet(:layout_5) } do %>
  <%= tabler_ui.table columns: columns, data: rows, striped: true, hover: true,
                      row_html: ->(row) { { class: "table-warning" } if row[:status] == "Away" } %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "table - responsive: \"sm\" (scrolls only below sm, instead of at every width)", code: snippet(:layout_22) } do %>
  <%= tabler_ui.table columns: columns, data: rows, responsive: "sm" %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "table - responsive: false (no scroll wrapper)", code: snippet(:layout_23) } do %>
  <%= tabler_ui.table columns: columns, data: rows, responsive: false %>
<% end %>

<% mobile_columns = [
  { label: "Name", value: ->(row) { row[:name] } },
  { label: "Role", value: ->(row) { row[:role] } },
  { label: "Department", value: ->(row) { row[:department] } },
  { label: "Location", value: ->(row) { row[:location] } },
  { label: "Status", class: "text-end",
    value: ->(row) { tabler_ui.status(text: row[:status], color: row[:status] == "Active" ? "success" : "secondary", dot: true) } }
] %>
<% mobile_rows = [
  { name: "Ada Lovelace", role: "Engineer", department: "Platform", location: "London", status: "Active" },
  { name: "Grace Hopper", role: "Admiral", department: "Navy", location: "Virginia", status: "Active" },
  { name: "Alan Turing", role: "Researcher", department: "Cryptography", location: "Bletchley", status: "Away" }
] %>
<%= render layout: "showcase/example", locals: { title: "table - mobile: true (card-stacked at all widths; data-label draws the headings)", code: snippet(:layout_24) } do %>
  <%= tabler_ui.table columns: mobile_columns, data: mobile_rows, mobile: true %>
<% end %>

<% table_demo_columns = [
  { label: "Name", sort: "name", value: ->(row) { row[:name] } },
  { label: "Status", sort: "status",
    value: ->(row) { tabler_ui.status(text: row[:status].capitalize,
                                       color: { "active" => "success", "away" => "warning" }.fetch(row[:status], "secondary"),
                                       dot: true) } },
  { label: "Created", sort: "created_at", value: ->(row) { row[:created_at].strftime("%b %-d, %Y") } },
  { label: "Actions", value: ->(row) { link_to "View", "#" } }
] %>
<% table_demo_sort_url = ->(key, dir) {
  layout_path(**{ sort: dir && key, dir: dir, q: params[:q], status: params[:status] }.compact_blank)
} %>
<% table_demo_pagination_url = ->(page) {
  layout_path(**{ sort: @table_demo_sort[:key], dir: @table_demo_sort[:dir], q: params[:q], status: params[:status], page: page }.compact_blank)
} %>
<%= render layout: "showcase/example", locals: { title: "table - frame: (Turbo Frame: sorting, filtering and paging without a page reload; search button: \"Search\"; filter min_chars: 3)", code: snippet(:layout_28) } do %>
  <%= tabler_ui.table columns: table_demo_columns, data: @table_demo_rows, hover: true,
                      sort: @table_demo_sort,
                      sort_url: table_demo_sort_url,
                      sort_reset: true,
                      frame: "table-demo",
                      filter: {
                        url: layout_path,
                        hidden: { sort: @table_demo_sort[:key], dir: @table_demo_sort[:dir] },
                        min_chars: 3,
                        fields: [
                          { name: "q", value: params[:q], button: "Search" },
                          { name: "status", type: :select, label: "Status", value: params[:status],
                            include_blank: true, options: %w[active away inactive] }
                        ],
                        reset: layout_path(**{ sort: @table_demo_sort[:key], dir: @table_demo_sort[:dir] }.compact_blank)
                      } %>
  <%= tabler_ui.pagination current: @table_demo_page, total: @table_demo_total_pages,
                            url: table_demo_pagination_url, frame: "table-demo" %>
<% end %>

<% inert_min_chars_columns = [
  { label: "Name", value: ->(row) { row[:name] } },
  { label: "Status", value: ->(row) { row[:status].capitalize } }
] %>
<% inert_min_chars_rows = [
  { name: "Ada Lovelace", status: "active" },
  { name: "Grace Hopper", status: "active" },
  { name: "Alan Turing", status: "away" }
] %>
<% inert_min_chars_q = params[:inert_q].to_s %>
<% inert_min_chars_filtered_rows = inert_min_chars_q.present? ? inert_min_chars_rows.select { |row| row[:name].downcase.include?(inert_min_chars_q.downcase) } : inert_min_chars_rows %>
<%= render layout: "showcase/example", locals: { title: "table - filter min_chars: 3 without frame: (no-op by design: 1 character filters immediately, no hint is shown)", code: snippet(:layout_29) } do %>
  <%= tabler_ui.table columns: inert_min_chars_columns, data: inert_min_chars_filtered_rows, hover: true,
                      filter: {
                        url: layout_path,
                        min_chars: 3,
                        fields: [
                          { name: "inert_q", value: inert_min_chars_q }
                        ]
                      } %>
<% end %>

