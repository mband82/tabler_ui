<% end %>

<%= render layout: "showcase/example", locals: { title: "navbar - overlap: true (background extends 9rem below it; content sits on top)", code: snippet(:layout_13) } do %>
  <%= tabler_ui.navbar(brand: link_to("MyApp", "#"), overlap: true) do |navbar| %>
    <% navbar.left do |nav| %>
      <% nav.add "Home", url: "#", active: true %>
    <% end %>
  <% end %>
