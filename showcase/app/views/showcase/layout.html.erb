<%= tabler_ui.page_header title: "Layout", pretitle: "Components" %>

<%= render layout: "showcase/example", locals: { title: "navbar", code: snippet(:layout_1) } do %>
  <%= tabler_ui.navbar(brand: link_to("MyApp", "#")) do |navbar| %>
    <% navbar.left do |nav| %>
      <% nav.add "Home", url: "#", active: true %>
      <% nav.add "Reports", url: "#" %>
      <% nav.dropdown "Admin", align: :end do |dd| %>
        <% dd.header "Manage" %>
        <% dd.item "Users", url: "#", icon: "users" %>
        <% dd.divider %>
        <% dd.item "Settings", url: "#", icon: "settings" %>
      <% end %>
    <% end %>
    <% navbar.right do |nav| %>
      <% nav.dark_mode_toggle %>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "navbar - expand: \"sm\" (collapses above sm, instead of the lg default)", code: snippet(:layout_10) } do %>
  <%= tabler_ui.navbar(brand: link_to("MyApp", "#"), expand: "sm") do |navbar| %>
    <% navbar.left do |nav| %>
      <% nav.add "Home", url: "#", active: true %>
      <% nav.add "Reports", url: "#" %>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "navbar - dark: true (text/icons only -- paired with bg-primary via html:)", code: snippet(:layout_11) } do %>
  <%= tabler_ui.navbar(brand: link_to("MyApp", "#"), dark: true, html: { class: "bg-primary" }) do |navbar| %>
    <% navbar.left do |nav| %>
      <% nav.add "Home", url: "#", active: true %>
      <% nav.add "Reports", url: "#" %>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "navbar - transparent: true", code: snippet(:layout_12) } do %>
