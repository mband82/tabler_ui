    <%= tabler_ui.navbar(brand: link_to("MyApp", "#"), transparent: true) do |navbar| %>
      <% navbar.left do |nav| %>
        <% nav.add "Home", url: "#", active: true %>
        <% nav.add "Reports", url: "#" %>
