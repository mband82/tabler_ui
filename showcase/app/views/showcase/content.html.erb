<%= tabler_ui.page_header title: "Content", pretitle: "Components" %>

<%= render layout: "showcase/example", locals: { title: "badge - colors, light, pill, outline, icon, notification", code: snippet(:content_1) } do %>
  <%= tabler_ui.badge text: "New", color: "blue" %>
  <%= tabler_ui.badge text: "Pending", color: "yellow", light: true %>
  <%= tabler_ui.badge text: "4", color: "red", pill: true %>
  <%= tabler_ui.badge text: "Draft", color: "secondary", outline: true %>
  <%= tabler_ui.badge text: "Star", color: "yellow", icon: "star" %>
  <%= tabler_ui.badge color: "red", notification: true, blink: true %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "badge - dot: true (fixed 10px dot; raises if combined with text/icon/content)", code: snippet(:content_24) } do %>
  <%= tabler_ui.badge color: "red", dot: true %>
  <%= tabler_ui.badge color: "green", dot: true %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "badge - icon_only: true (zeroes horizontal padding; raises if combined with text)", code: snippet(:content_25) } do %>
  <%= tabler_ui.badge color: "blue", icon: "star", icon_only: true %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "badge_list - wraps several badges in a flex .badges-list container", code: snippet(:content_26) } do %>
  <%= tabler_ui.badge_list do |slots| %>
    <% slots.body do %>
      <%= tabler_ui.badge text: "New" %>
      <%= tabler_ui.badge text: "Hot" %>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "alert - colors, dismissible, important, icon, action link", code: snippet(:content_2) } do %>
  <%= tabler_ui.alert color: "success", text: "Your changes have been saved!" %>
  <%= tabler_ui.alert color: "danger", title: "Error", text: "Something went wrong.", dismissible: true %>
  <%= tabler_ui.alert color: "warning", text: "Your trial expires in 3 days.", important: true %>
  <%= tabler_ui.alert color: "info", text: "New update available.", url: "#", link_text: "See what's new" %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "alert - minor: true (transparent background, neutral border)", code: snippet(:content_27) } do %>
  <%= tabler_ui.alert color: "info", text: "Minor style alert.", minor: true %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "alert - color: 'muted' (alert-only colour value)", code: snippet(:content_28) } do %>
  <%= tabler_ui.alert color: "muted", text: "Muted alert." %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "alert - link_style: :action (underlined action link instead of the default alert-link)", code: snippet(:content_29) } do %>
  <%= tabler_ui.alert color: "info", text: "New update available.", url: "#", link_text: "See what's new", link_style: :action %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "avatar - initials, image, generated identicon, sizes, show_details", code: snippet(:content_3) } do %>
  <%= tabler_ui.avatar initials: "JD", size: "md" %>
  <%= tabler_ui.avatar image: "https://picsum.photos/200", size: "md" %>
  <%= tabler_ui.avatar name: "Ada Lovelace", size: "md" %>
  <%= tabler_ui.avatar initials: "SM", size: "xl" %>
  <%= tabler_ui.avatar initials: "JD", show_details: true, title: "Jane Doe", subtitle: "Admin" %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "avatar - cover: true (pulls the avatar up over a banner via negative margin)", code: snippet(:content_30) } do %>
  <div>
    <div class="bg-blue" style="height: 60px; border-radius: 4px;"></div>
    <%= tabler_ui.avatar initials: "JD", size: "xl", cover: true %>
  </div>
<% end %>

<%= render layout: "showcase/example", locals: { title: "avatar - overlay slot for a status dot, shown at size md and xl to compare scaling", code: snippet(:content_31) } do %>
  <span class="me-3"><%= tabler_ui.avatar initials: "JD", size: "md" do |slots| %>
    <% slots.overlay do %><%= tag.span(class: "badge bg-success") %><% end %>
  <% end %></span>
  <span><%= tabler_ui.avatar initials: "SM", size: "xl" do |slots| %>
    <% slots.overlay do %><%= tag.span(class: "badge bg-success") %><% end %>
  <% end %></span>
<% end %>

<%= render layout: "showcase/example", locals: { title: "icon - outline/filled, color, animations, rule 5 html:", code: snippet(:content_4) } do %>
  <span class="me-3"><%= tabler_ui.icon icon: "heart" %></span>
  <span class="me-3"><%= tabler_ui.icon icon: "heart", filled: true, color: "danger" %></span>
  <span class="me-3"><%= tabler_ui.icon icon: "star", filled: true, color: "yellow", pulse: true %></span>
  <span class="me-3"><%= tabler_ui.icon icon: "refresh", rotate: true %></span>
  <span class="me-3"><%= tabler_ui.icon icon: "bell", tada: true %></span>
  <span class="me-3"><%= tabler_ui.icon icon: "user", html: { class: "me-2", data: { testid: "user-icon" } } %></span>
<% end %>

<%= render layout: "showcase/example", locals: { title: "illustration - light/dark theme, sized", code: snippet(:content_5) } do %>
  <%= tabler_ui.illustration name: "search", size: :sm %>
  <%= tabler_ui.illustration name: "search", theme: "dark", size: :sm %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "status - dot, animated, standalone, indicator, light", code: snippet(:content_6) } do %>
  <%= tabler_ui.status text: "Active", color: "green" %>
  <%= tabler_ui.status text: "Online", color: "green", dot: true %>
  <%= tabler_ui.status text: "Processing", color: "blue", dot: true, animated: true %>
  <%= tabler_ui.status text: "Pending", color: "yellow", light: true %>
  <%= tabler_ui.status color: "green", dot: true, standalone: true %>
  <%= tabler_ui.status color: "red", indicator: true, animated: true %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "progress - auto color, striped/animated, labeled", code: snippet(:content_7) } do %>
  <%= tabler_ui.progress percent: 42 %>
  <%= tabler_ui.progress percent: 82, color: "auto" %>
  <%= tabler_ui.progress percent: 95, color: "auto" %>
  <%= tabler_ui.progress percent: 60, striped: true, animated: true %>
  <%= tabler_ui.progress percent: 60, label: "Uploading", show_percent: true %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "progress - indeterminate: true (animated unknown-progress bar; raises if combined with percent:)", code: snippet(:content_32) } do %>
  <%= tabler_ui.progress indeterminate: true %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "progress - separated: true (draws a ring per bar; only visible with several bars on one track, which is progress-stacked and not built yet -- inert here for now)", code: snippet(:content_33) } do %>
  <%= tabler_ui.progress percent: 60, separated: true %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "button - shape: 'pill' (btn-pill, wider padding) vs. default", code: snippet(:content_34) } do %>
  <%= tabler_ui.button text: "Default", color: "primary" %>
  <%= tabler_ui.button text: "Pill", color: "primary", shape: "pill" %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "button - loading: true (sets pointer-events: none only; pair with disabled: true for a real disable)", code: snippet(:content_35) } do %>
  <%= tabler_ui.button text: "Saving...", color: "primary", loading: true, disabled: true %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "button - animate_icon (hover to see the effect): true = default slide, plus named modifiers", code: snippet(:content_36) } do %>
  <%= tabler_ui.button text: "Next", color: "primary", icon: "arrow-right", animate_icon: true %>
  <%= tabler_ui.button text: "Refresh", color: "primary", icon: "refresh", animate_icon: "rotate" %>
  <%= tabler_ui.button text: "Notify", color: "primary", icon: "bell", animate_icon: "shake" %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "button - ghost: true (transparent until hovered; combines with color:, raises with outline: true)", code: snippet(:content_37) } do %>
  <%= tabler_ui.button text: "Ghost", color: "primary", ghost: true %>
  <%= tabler_ui.button text: "Ghost danger", color: "danger", ghost: true %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "button - brand colors (buttons only), plain and outlined", code: snippet(:content_38) } do %>
  <%= tabler_ui.button text: "GitHub", color: "github" %>
  <%= tabler_ui.button text: "Twitter", color: "twitter" %>
  <%= tabler_ui.button text: "Facebook", color: "facebook", outline: true %>
  <%= tabler_ui.button text: "Muted", color: "muted" %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "button - floating: true (position: fixed -- pinned to the viewport's bottom-left corner, not to this card; shown once)", code: snippet(:content_39) } do %>
  <%= tabler_ui.button text: "Add", color: "primary", icon: "plus", floating: true %>
<% end %>

<div class="row row-cards">
  <div class="col-md-4">
    <%= render layout: "showcase/example", locals: { title: "stat_card - positive trend", code: snippet(:content_8) } do %>
      <%= tabler_ui.stat_card label: "Sales", value: "456", icon: "shopping-cart", trend: 12 %>
    <% end %>
  </div>
  <div class="col-md-4">
    <%= render layout: "showcase/example", locals: { title: "stat_card - negative trend, description, link", code: snippet(:content_9) } do %>
      <%= tabler_ui.stat_card label: "New clients", value: "18", trend: -8,
                              description: "vs. last month", url: "#" %>
    <% end %>
  </div>
  <div class="col-md-4">
    <%= render layout: "showcase/example", locals: { title: "stat_card - colored icon", code: snippet(:content_10) } do %>
      <%= tabler_ui.stat_card label: "Revenue", value: "$9,600", icon: "currency-dollar", color: "green" %>
    <% end %>
  </div>
</div>

<%= render layout: "showcase/example", locals: { title: "placeholder - text, avatar, image, button, list, animation", code: snippet(:content_11) } do %>
  <%= tabler_ui.placeholder type: :text, lines: [10, 11, 8] %>
  <%= tabler_ui.placeholder type: :avatar %>
  <div class="mb-2"><%= tabler_ui.placeholder type: :image, ratio: "21x9" %></div>
  <%= tabler_ui.placeholder type: :button, width: 4, color: "primary" %>
  <%= tabler_ui.placeholder type: :text, width: 6, animation: :glow %>
<% end %>

<div class="row row-cards">
  <div class="col-md-6">
    <%= render layout: "showcase/example", locals: { title: "ribbon - corner label on a card", code: snippet(:content_12) } do %>
      <div class="card position-relative">
        <%= tabler_ui.ribbon text: "New", color: "blue" %>
        <div class="card-body">Ribbon pinned to the card's top-right corner.</div>
      </div>
    <% end %>
  </div>
  <div class="col-md-6">
    <%= render layout: "showcase/example", locals: { title: "ribbon - bookmark shape, bottom/start", code: snippet(:content_13) } do %>
      <div class="card position-relative">
        <%= tabler_ui.ribbon text: "Sale", color: "red", position: :bottom, align: :start, bookmark: true %>
        <div class="card-body">Bookmark-shaped ribbon, bottom-left.</div>
      </div>
    <% end %>
  </div>
</div>

<%= render layout: "showcase/example", locals: { title: "spinner - border/grow, sizes, colors, custom label", code: snippet(:content_14) } do %>
  <span class="me-3"><%= tabler_ui.spinner %></span>
  <span class="me-3"><%= tabler_ui.spinner type: :grow %></span>
  <span class="me-3"><%= tabler_ui.spinner size: "sm", color: "blue" %></span>
  <span class="me-3"><%= tabler_ui.spinner label: "Saving..." %></span>
<% end %>

<%= render layout: "showcase/example", locals: { title: "dimmer - active loading overlay", code: snippet(:content_15) } do %>
  <%= tabler_ui.dimmer active: true do |slots| %>
    <% slots.content do %>
      <div class="p-4">Table rows would render here.</div>
    <% end %>
  <% end %>
<% end %>

<div class="row row-cards">
  <div class="col-md-6">
    <%= render layout: "showcase/example", locals: { title: "empty - title, subtitle, illustration, action", code: snippet(:content_16) } do %>
      <%= tabler_ui.empty image: "search", title: "No results found",
                          subtitle: "Try adjusting your search or filter." do |slots| %>
        <% slots.action do %>
          <%= tabler_ui.button text: "Clear filters", url: "#" %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <div class="col-md-6">
    <%= render layout: "showcase/example", locals: { title: "empty - header, icon instead of illustration, bordered", code: snippet(:content_17) } do %>
      <%= tabler_ui.empty icon: "mood-empty", header: "404",
                          title: "Page not found", bordered: true %>
    <% end %>
  </div>
</div>

<%= render layout: "showcase/example", locals: { title: "timeline - icons, colors, nested card content", code: snippet(:content_18) } do %>
  <%= tabler_ui.timeline do |t| %>
    <% t.item icon: "check", color: "green" do %>
      <strong>Order placed</strong>
      <div class="text-secondary">2 hours ago</div>
    <% end %>
    <% t.item icon: "truck", color: "blue" do %>
      Shipped
    <% end %>
    <% t.item icon: "flag", color: "red" do %>
      Flagged for review
    <% end %>
  <% end %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "steps - current progress, vertical, counter, color", code: snippet(:content_19) } do %>
  <%= tabler_ui.steps(current: 2, counter: true, color: "azure") do |steps| %>
    <% steps.item("Account", url: "#") %>
    <% steps.item("Profile", url: "#") %>
    <% steps.item("Confirm") %>
  <% end %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "breadcrumb - style: :arrows, muted", code: snippet(:content_20) } do %>
  <%= tabler_ui.breadcrumb(style: :arrows, muted: true) do |breadcrumb| %>
    <% breadcrumb.item("Home", url: "#") %>
    <% breadcrumb.item("Library", url: "#") %>
    <% breadcrumb.item("Data") %>
  <% end %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "pagination - computed mode (current:/total:/url:)", code: snippet(:content_21) } do %>
  <% current_page = [[(params[:page] || 3).to_i, 1].max, 10].min %>
  <%= tabler_ui.pagination current: current_page, total: 10,
                           url: ->(n) { content_path(page: n) } %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "pagination - size: :sm, circle:, outline:", code: snippet(:content_22) } do %>
  <%= tabler_ui.pagination current: 1, total: 5, url: ->(n) { "?page=#{n}" },
                           size: :sm, circle: true, outline: true %>
<% end %>

<%= render layout: "showcase/example", locals: { title: "rating - custom choices, colored, clearable", code: snippet(:content_23) } do %>
  <%= tabler_ui.rating %>
  <%= tabler_ui.rating choices: [{ value: 1, label: "Bad" }, { value: 2, label: "Ok" }, { value: 3, label: "Great" }],
                       max_stars: 3, color: "yellow", value: 2 %>
<% end %>
