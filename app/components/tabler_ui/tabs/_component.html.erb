<%# Tabler UI Tabs Component %>
<%= tag.div(**tabs.root_attributes) do %>
  <%# TODO(rule 6): data-bs-toggle="tabs"/"tab" drive Bootstrap's Tab class
      directly. Left as-is per instructions -- wrap this in a shared
      tabler-ui--tab Stimulus controller once that lands. %>
  <%= tag.ul("data-bs-toggle": "tabs", role: "tablist", **tabs.nav_attributes) do %>
    <% tabs.tabs.each do |tab| %>
      <li class="nav-item" role="presentation">
        <%= tag.a(href: "##{tab.id}", "data-bs-toggle": "tab", role: "tab",
                   "aria-selected": tab.active, **tabs.tab_attributes(tab)) do %>
          <% if tab.icon.present? %>
            <%= tabler_ui.icon(icon: tab.icon, html: { class: "me-1" }) %>
          <% end %>
          <%= tab.title %>
          <% if tab.badge.present? %>
            <span class="ms-1"><%= tabler_ui.badge(**tabs.badge_options_for(tab)) %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  <% end %>

  <%= tag.div(**tabs.content_attributes) do %>
    <% tabs.tabs.each do |tab| %>
      <div class="tab-pane<%= ' active show' if tab.active %>" id="<%= tab.id %>" role="tabpanel">
        <%= capture(&tab.content) if tab.content %>
      </div>
    <% end %>
  <% end %>
<% end %>
