<%= tag.div(**dropdown.root_attributes) do %>
  <%= tag.button(type: "button", "data-bs-toggle": "dropdown", "data-controller": "tabler-ui--dropdown-menu",
                 "aria-expanded": "false", **dropdown.toggle_attributes) do %>
    <%= dropdown.label %>
  <% end %>
  <%= tag.div(**dropdown.menu_attributes) do %>
    <% dropdown.items.each do |item| %>
      <% case item.type %>
      <% when :divider %>
        <div class="dropdown-divider"></div>
      <% when :header %>
        <h6 class="dropdown-header"><%= item.title %></h6>
      <% when :item %>
        <%
          item_content = capture do
            if item.icon.present?
              concat tabler_ui.icon(icon: item.icon, html: { class: "me-1" })
            end
            concat item.title
          end
        %>
        <% if item.method && item.method != :get %>
          <%= button_to item.url, method: item.method, disabled: item.disabled,
                         **dropdown.item_attributes(item) do %>
            <%= item_content %>
          <% end %>
        <% else %>
          <%= link_to item.url, disabled: item.disabled, **dropdown.item_attributes(item) do %>
            <%= item_content %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
