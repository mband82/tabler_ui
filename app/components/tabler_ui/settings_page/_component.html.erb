<%# Tabler UI SettingsPage Component %>
<%= tag.div(**settings_page.root_attributes) do %>
  <div class="row g-0">
    <%# Sidebar Navigation %>
    <%= tag.div(**settings_page.sidebar_attributes) do %>
      <h4 class="subheader"><%= settings_page.title %></h4>
      <div class="list-group list-group-transparent">
        <% settings_page.items.each do |item| %>
          <%# TODO(rule 6): data-bs-toggle="list" drives Bootstrap's Tab class
              directly. Left as-is per instructions -- once tabs is converted to
              Stimulus, wrap this in a shared tabler-ui--tab controller, since
              Bootstrap's Tab class backs both data-bs-toggle="tab" and "list". %>
          <%= tag.a(href: "##{item.id}", "data-bs-toggle": "list", **settings_page.item_attributes(item)) do %>
            <% if item.icon.present? %>
              <%= tabler_ui.icon(icon: item.icon, html: { class: "me-2" }) %>
            <% end %>
            <%= item.title %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <%# Content Area %>
    <%= tag.div(**settings_page.content_attributes) do %>
      <div class="tab-content">
        <% settings_page.items.each do |item| %>
          <div class="tab-pane<%= ' active show' if item.active %>" id="<%= item.id %>">
            <%= capture(&item.content) if item.content %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
