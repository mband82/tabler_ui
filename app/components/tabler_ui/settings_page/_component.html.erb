<%= tag.div(**settings_page.root_attributes) do %>
  <div class="row g-0">
    <%= tag.div(**settings_page.sidebar_attributes) do %>
      <h4 class="subheader"><%= settings_page.title %></h4>
      <div class="list-group list-group-transparent" data-controller="tabler-ui--tab">
        <% settings_page.items.each do |item| %>
          <%= tag.a(href: "##{item.id}", "data-bs-toggle": "list", "data-tabler-ui--tab-target": "toggle",
                     **settings_page.item_attributes(item)) do %>
            <% if item.icon.present? %>
              <%= tabler_ui.icon(icon: item.icon, html: { class: "me-2" }) %>
            <% end %>
            <%= item.title %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <%= tag.div(**settings_page.content_attributes) do %>
      <div class="tab-content">
        <% settings_page.items.each do |item| %>
          <%= tag.div(id: item.id, **settings_page.pane_attributes(item)) do %>
            <%= capture(&item.content) if item.content %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
