<%# Authorization check: if action and subject are provided and can? is
    available, check permission. Applies to regular links and dropdown items
    -- dropdowns themselves, dividers and the dark mode toggle always show. %>
<% authorized = ->(entry) { entry.action.present? && entry.subject.present? && respond_to?(:can?) ? can?(entry.action, entry.subject) : true } %>
<% item_active = ->(entry) { entry.active.nil? ? (entry.url.present? && current_page?(entry.url)) : entry.active } %>

<% case item.type %>
<% when :dark_mode_toggle %>
  <%= tag.li(**navbar.item_attributes(item)) do %>
    <%= tabler_ui.dark_mode_toggle(**item.toggle_options) %>
  <% end %>
<% when :divider %>
  <%= tag.li(**navbar.item_attributes(item)) do %>
    <span class="nav-link px-0 text-secondary">|</span>
  <% end %>
<% when :dropdown %>
  <% visible_items = item.submenu.select { |sub| authorized.call(sub) } %>
  <% visible_items = visible_items.drop_while { |sub| sub.type == :divider } %>
  <% visible_items = visible_items.reverse.drop_while { |sub| sub.type == :divider }.reverse %>
  <% if visible_items.any? { |sub| sub.type != :divider } %>
    <% dropdown_active = visible_items.any? { |sub| sub.type == :item && item_active.call(sub) } %>
    <%= tag.li(**navbar.item_attributes(item, active: dropdown_active)) do %>
      <%= tag.a(**navbar.dropdown_toggle_attributes(item)) do %>
        <%= item.title %>
      <% end %>
      <div class="dropdown-menu<%= ' dropdown-menu-end' if item.align == :end %>">
        <% visible_items.each do |sub| %>
          <% case sub.type %>
          <% when :divider %>
            <div class="dropdown-divider"></div>
          <% when :header %>
            <h6 class="dropdown-header"><%= sub.title %></h6>
          <% when :item %>
            <% sub_active = item_active.call(sub) %>
            <%
              item_content = capture do
                concat tabler_ui.icon(icon: sub.icon, html: { class: "me-1" }) if sub.icon.present?
                concat sub.title
              end
            %>
            <% if sub.method.present? && sub.method != :get %>
              <%= button_to sub.url, navbar.dropdown_item_link_attributes(sub, active: sub_active).merge(method: sub.method) do %>
                <%= item_content %>
              <% end %>
            <% else %>
              <%= link_to sub.url, navbar.dropdown_item_link_attributes(sub, active: sub_active) do %>
                <%= item_content %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% when :link %>
  <% if authorized.call(item) %>
    <% active = item_active.call(item) %>
    <%= tag.li(**navbar.item_attributes(item, active: active)) do %>
      <% if item.method.present? && item.method != :get %>
        <%= button_to item.title, item.url, navbar.link_attributes(item, active: active).merge(method: item.method) %>
      <% else %>
        <%= link_to item.title, item.url, navbar.link_attributes(item, active: active) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
