<% if datagrid.has_items? %>
  <%= tag.div(**datagrid.root_attributes) do %>
    <% datagrid.items.each do |item| %>
      <%= tag.div(**datagrid.item_attributes(item)) do %>
        <%= tag.div(item[:title], **datagrid.title_attributes(item)) %>
        <%= tag.div(**datagrid.content_attributes(item)) do %>
          <% if item[:block] %>
            <%= capture(&item[:block]) %>
          <% else %>
            <%= item[:content] %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
