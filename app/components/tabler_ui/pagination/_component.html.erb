<nav aria-label="<%= pagination.aria_label %>">
  <%= tag.ul(**pagination.root_attributes) do %>
    <% pagination.items.each do |item| %>
      <%= tag.li(**pagination.item_attributes(item)) do %>
        <% if pagination.linkable?(item) %>
          <%= link_to pagination.item_text(item), item.url, class: "page-link" %>
        <% else %>
          <%= tag.span(pagination.item_text(item), class: "page-link") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</nav>
