<% table_markup = capture do %>
  <%= tag.table(**table.table_attributes) do %>
    <%= tag.thead(**table.thead_attributes) do %>
      <%= tag.tr do %>
        <% table.columns.each do |col| %>
          <% if table.sortable?(col) %>
            <%= tag.th(**table.header_cell_attributes(col)) do %>
              <%= tag.a(col[:label], **table.sort_attributes(col)) %>
            <% end %>
          <% else %>
            <%= tag.th(col[:label], **table.cell_attributes(col)) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= tag.tbody(**table.tbody_attributes) do %>
      <% table.data.each do |row| %>
        <%= tag.tr(**table.row_attributes(row)) do %>
          <% table.columns.each do |col| %>
            <%= tag.td(col[:value].call(row), **table.data_cell_attributes(col)) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if table.filter? %>
  <% has_filter_slot = defined?(slots) && slots.present?(:filter) %>
  <% table.guard_filter_slot!(has_filter_slot) %>
  <% filter_markup = capture do %>
    <%= tag.div(**table.filter_attributes) do %>
      <%= tag.form(**table.filter_form_attributes) do %>
        <% table.filter_hidden_fields.each do |name, value| %>
          <%= tag.input(type: "hidden", name: name, value: value) %>
        <% end %>

        <% if has_filter_slot %>
          <%= slots.filter %>
        <% else %>
          <% table.filter_fields.each do |field| %>
            <%= tag.div(class: table.filter_field_wrapper_class(field)) do %>
              <% if field[:label].present? %>
                <%= tag.label(field[:label], for: field[:id], class: "form-label") %>
              <% end %>
              <% if field[:type] == :select %>
                <%= select_tag field[:name], options_for_select(field[:select_choices], field[:value]),
                                **table.filter_field_select_attributes(field) %>
              <% elsif field[:button].present? %>
                <%= tag.div(class: "input-group") do %>
                  <%= tag.input(**table.filter_field_input_attributes(field)) %>
                  <%= tag.button(field[:button], **table.filter_field_button_attributes(field)) %>
                  <% if table.filter_field_hint?(field) %>
                    <%= tag.div(table.filter_min_chars_hint, **table.filter_field_hint_attributes(field)) %>
                  <% end %>
                <% end %>
              <% else %>
                <%= tag.input(**table.filter_field_input_attributes(field)) %>
                <% if table.filter_field_hint?(field) %>
                  <%= tag.div(table.filter_min_chars_hint, **table.filter_field_hint_attributes(field)) %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <% if table.filter_show_buttons? %>
          <%= tag.div(class: "col-12 col-md-auto") do %>
            <% if table.filter_show_submit? %>
              <%= tag.button(table.filter_submit_label, type: "submit", class: "btn btn-primary") %>
            <% end %>
            <% if table.filter_show_reset? %>
              <%= tag.a(table.filter_reset_label, **table.filter_reset_attributes) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if table.card? %>
  <%= tag.div(**table.root_attributes) do %>
    <%= filter_markup if table.filter? %>
    <% responsive_markup = tag.div(table_markup, **table.responsive_attributes) %>
    <%# frame: wraps only .table-responsive, never the .card -- see the %>
    <%# component's "Turbo Frames" class docs for why %>
    <%= table.frame? ? tag.turbo_frame(responsive_markup, **table.frame_attributes) : responsive_markup %>
  <% end %>
<% else %>
  <%= filter_markup if table.filter? %>
  <% root_markup = tag.div(table_markup, **table.root_attributes) %>
  <%= table.frame? ? tag.turbo_frame(root_markup, **table.frame_attributes) : root_markup %>
<% end %>
