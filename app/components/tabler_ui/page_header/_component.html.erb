<%= tag.div(**page_header.root_attributes) do %>
  <div class="row g-2 align-items-center">
    <div class="col">
      <% if page_header.pretitle? %>
        <%= tag.div(page_header.pretitle, **page_header.pretitle_attributes) %>
      <% end %>
      <%= tag.h2(page_header.title, **page_header.title_attributes) %>
      <% if page_header.subtitle? %>
        <%= tag.div(page_header.subtitle, **page_header.subtitle_attributes) %>
      <% end %>
    </div>
    <% if defined?(slots) && slots.present?(:buttons) %>
      <%= tag.div(**page_header.buttons_attributes) do %>
        <div class="btn-list">
          <%= slots.buttons %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
