<nav aria-label="<%= breadcrumb.aria_label %>">
  <%= tag.ol(**breadcrumb.root_attributes) do %>
    <% breadcrumb.items.each do |item| %>
      <%= tag.li(**breadcrumb.item_attributes(item)) do %>
        <% if breadcrumb.link?(item) %>
          <%= tag.a(item.title, **breadcrumb.link_attributes(item)) %>
        <% else %>
          <%= item.title %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</nav>
