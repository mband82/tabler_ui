<%= tag.div(**alert.root_attributes) do %>
  <% if alert.dismissible %>
    <%= tag.a(**alert.dismiss_attributes) %>
  <% end %>

  <div class="d-flex">
    <% if alert.has_icon? %>
      <%= tag.div(**alert.icon_attributes) do %>
        <%= tabler_ui.icon(icon: alert.default_icon, html: { class: "alert-icon" }) %>
      <% end %>
    <% end %>

    <div>
      <% if alert.title.present? %>
        <%= tag.h4(alert.title, **alert.title_attributes) %>
      <% end %>

      <% if alert.text.present? %>
        <div class="text-secondary"><%= alert.text %></div>
      <% elsif defined?(slots) && slots.present?(:body) %>
        <%= slots.body %>
      <% end %>

      <% if alert.url.present? %>
        <%= tag.a(alert.link_text, **alert.link_attributes) %>
      <% end %>
    </div>
  </div>
<% end %>
