<%# Tabler UI Alert Component %>
<%= tag.div(**alert.root_attributes) do %>
  <% if alert.dismissible %>
    <%# TODO(rule 6): this drives Bootstrap's alert dismiss directly via data-bs-dismiss;
        wrap it with a tabler-ui--alert Stimulus controller once that lands. %>
    <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
  <% end %>

  <div class="d-flex">
    <% if alert.has_icon? %>
      <%= tag.div(**alert.icon_attributes) do %>
        <%= tabler_ui.icon(icon: alert.default_icon, html: { class: "alert-icon" }) %>
      <% end %>
    <% end %>

    <div>
      <% if alert.title.present? %>
        <%= tag.h4(alert.title, **alert.title_attributes) %>
      <% end %>

      <% if alert.text.present? %>
        <div class="text-secondary"><%= alert.text %></div>
      <% elsif defined?(slots) && slots.present?(:body) %>
        <%= slots.body %>
      <% end %>

      <% if alert.url.present? %>
        <%= link_to alert.link_text, alert.url, class: "alert-link" %>
      <% end %>
    </div>
  </div>
<% end %>
