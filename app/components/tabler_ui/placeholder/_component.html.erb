<%# Tabler UI Placeholder Component %>
<% case placeholder.type %>
<% when :text %>
  <%# Single or multiple text placeholder lines, always inside a wrapper so
      the html: hook has a stable root regardless of whether animation is on %>
  <%= tag.div(**placeholder.text_wrapper_attributes) do %>
    <% placeholder.text_lines.each do |line_width| %>
      <%= tag.div class: placeholder.text_line_classes(line_width) %>
    <% end %>
  <% end %>

<% when :avatar %>
  <%# Avatar placeholder %>
  <%= tag.div(**placeholder.avatar_attributes) %>

<% when :image %>
  <%# Image placeholder with aspect ratio %>
  <%= tag.div(**placeholder.image_attributes) %>

<% when :button %>
  <%# Button placeholder %>
  <%= tag.a(**placeholder.button_attributes) %>

<% when :card %>
  <%# Full card placeholder skeleton %>
  <%= tag.div(**placeholder.card_attributes) do %>
    <% if placeholder.show_image %>
      <%= tag.div class: "ratio ratio-21x9 card-img-top placeholder" %>
    <% end %>
    <%= tag.div(**placeholder.card_body_attributes) do %>
      <%= tag.div class: "placeholder col-9 mb-3" %>
      <%= tag.div class: "placeholder placeholder-xs col-10" %>
      <%= tag.div class: "placeholder placeholder-xs col-11" %>
      <% if placeholder.show_button %>
        <%= tag.div class: "mt-3" do %>
          <%= tag.a "", href: "#", tabindex: "-1", class: "btn btn-primary disabled placeholder col-4", "aria-hidden": "true" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

<% when :list %>
  <%# List item placeholder with avatar %>
  <%= tag.div(**placeholder.list_attributes) do %>
    <div class="row align-items-center">
      <div class="col-auto">
        <div class="avatar avatar-rounded placeholder"></div>
      </div>
      <div class="col-7">
        <div class="placeholder placeholder-xs col-9"></div>
        <div class="placeholder placeholder-xs col-7"></div>
      </div>
      <div class="col-2 ms-auto text-end">
        <div class="placeholder placeholder-xs col-8"></div>
        <div class="placeholder placeholder-xs col-10"></div>
      </div>
    </div>
  <% end %>

<% else %>
  <%# Default: simple placeholder span for a type outside TYPES %>
  <%= tag.span(**placeholder.default_attributes) %>
<% end %>
